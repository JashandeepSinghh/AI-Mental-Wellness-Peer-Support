.env
.env.*
!.env.example

# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# All virtual environments, including .venv-1 and .venv-2
.venv*/
venv*/
env*/

# Frontend dependencies and build output
node_modules/
frontend/node_modules/
frontend/dist/
dist/

