
# Copy this file to .env and configure your local values.

APP_NAME=AI Mental Wellness and Peer Support API
APP_VERSION=1.0.0
APP_DESCRIPTION=Backend API for an AI-powered mental wellness and peer support application.

ENVIRONMENT=development
DEBUG=True

HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","Accept"]

# ============================================================
# SQLITE DATABASE
# ============================================================

SQLITE_DATABASE_PATH=data/mental_wellness.db
SQLITE_ECHO=False

SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# EMAIL / SMTP CONFIGURATION
# ============================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Mental Wellness Support

SMTP_STARTTLS=True
SMTP_USE_TLS=False
SMTP_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
LOG_FILE=logs/backend.log

MAX_REQUEST_TEXT_LENGTH=20000
REQUEST_TIMEOUT_SECONDS=60

MODEL_ROOT=D:/Projects/4AiMentalWellnessPeerSupport/models

EMOTION_MODEL_PATH=D:/Projects/4AiMentalWellnessPeerSupport/models/emotion/goemotions_distilbert/best_checkpoint
SENTIMENT_MODEL_PATH=D:/Projects/4AiMentalWellnessPeerSupport/models/sentiment/tweeteval_distilbert/best_checkpoint
STRESS_MODEL_PATH=D:/Projects/4AiMentalWellnessPeerSupport/models/stress/dreaddit_distilbert/best_checkpoint
LONELINESS_MODEL_PATH=D:/Projects/4AiMentalWellnessPeerSupport/models/loneliness/fig_loneliness_distilbert/best_checkpoint
VAD_LEXICON_PATH=D:/Projects/4AiMentalWellnessPeerSupport/datasets/processed/nrc_vad/standardized/nrc_vad.csv

INFERENCE_DEVICE=auto
MODEL_LOAD_ON_STARTUP=False
INFERENCE_BATCH_SIZE=8

STORE_CONVERSATIONS=False
STORE_ANALYTICS=False
ENABLE_REQUEST_LOGGING=True
